{
  "name": "easypage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "schema": "tsx scripts/schema.ts",
    "test:browser": "node scripts/browser-check.mjs && node scripts/workflow-check.mjs",
    "start": "tsx server/index.ts",
    "build:static": "tsc -b && VITE_STORAGE_MODE=browser vite build --base=./ --outDir dist-static"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.24.5"
  }
}
