{
  "$ref": "#/definitions/style-pack",
  "definitions": {
    "style-pack": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string",
              "const": "0.1.0"
            },
            "schemaVersion": {
              "type": "string",
              "const": "0.1"
            },
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "planned"
              ]
            },
            "catalog": {
              "type": "boolean",
              "default": true
            },
            "description": {
              "type": "string"
            },
            "supportedIntents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sampleDocument": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "version",
            "schemaVersion",
            "status",
            "description",
            "supportedIntents",
            "sampleDocument"
          ],
          "additionalProperties": false
        },
        "tokens": {
          "type": "object",
          "properties": {
            "colors": {
              "type": "object",
              "properties": {
                "paper": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "ink": {
                  "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                },
                "muted": {
                  "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                },
                "accent": {
                  "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                },
                "line": {
                  "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                }
              },
              "required": [
                "paper",
                "ink",
                "muted",
                "accent",
                "line"
              ],
              "additionalProperties": false
            },
            "typography": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minSize": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "leading": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tracking": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "ink",
                      "muted",
                      "accent"
                    ]
                  },
                  "italic": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "family",
                  "size",
                  "minSize",
                  "leading",
                  "tracking",
                  "color",
                  "italic"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "colors",
            "typography"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "single",
                  "spread"
                ]
              },
              "description": {
                "type": "string"
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "semantic": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "addable": {
                      "type": "boolean"
                    },
                    "removable": {
                      "type": "boolean"
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "eyebrow",
                        "title",
                        "body",
                        "caption",
                        "quote",
                        "image"
                      ]
                    },
                    "defaultEffects": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "opacity"
                              },
                              "value": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            },
                            "required": [
                              "type",
                              "value"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "blend"
                              },
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "normal",
                                  "multiply",
                                  "screen",
                                  "overlay",
                                  "soft-light"
                                ]
                              }
                            },
                            "required": [
                              "type",
                              "mode"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "blur"
                              },
                              "radius": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 40
                              }
                            },
                            "required": [
                              "type",
                              "radius"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "shadow"
                              },
                              "dx": {
                                "type": "number",
                                "minimum": -100,
                                "maximum": 100
                              },
                              "dy": {
                                "type": "number",
                                "minimum": -100,
                                "maximum": 100
                              },
                              "blur": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 60
                              },
                              "color": {
                                "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                              },
                              "opacity": {
                                "$ref": "#/definitions/style-pack/properties/layouts/items/properties/slots/items/properties/defaultEffects/items/anyOf/0/properties/value"
                              }
                            },
                            "required": [
                              "type",
                              "dx",
                              "dy",
                              "blur",
                              "color",
                              "opacity"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "tint"
                              },
                              "color": {
                                "$ref": "#/definitions/style-pack/properties/tokens/properties/colors/properties/paper"
                              },
                              "amount": {
                                "$ref": "#/definitions/style-pack/properties/layouts/items/properties/slots/items/properties/defaultEffects/items/anyOf/0/properties/value"
                              }
                            },
                            "required": [
                              "type",
                              "color",
                              "amount"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "semantic",
                    "type",
                    "required",
                    "addable",
                    "removable",
                    "style",
                    "defaultEffects"
                  ],
                  "additionalProperties": false
                }
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "frame": {
                            "type": "object",
                            "properties": {
                              "x": {
                                "$ref": "#/definitions/style-pack/properties/layouts/items/properties/slots/items/properties/defaultEffects/items/anyOf/0/properties/value"
                              },
                              "y": {
                                "$ref": "#/definitions/style-pack/properties/layouts/items/properties/slots/items/properties/defaultEffects/items/anyOf/0/properties/value"
                              },
                              "width": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 1
                              },
                              "height": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 1
                              }
                            },
                            "required": [
                              "x",
                              "y",
                              "width",
                              "height"
                            ],
                            "additionalProperties": false
                          },
                          "flow": {
                            "type": "string",
                            "enum": [
                              "stack",
                              "overlay"
                            ]
                          },
                          "gap": {
                            "type": "number",
                            "minimum": 0
                          },
                          "scope": {
                            "type": "string",
                            "enum": [
                              "page",
                              "left",
                              "right",
                              "spread"
                            ]
                          },
                          "gutterSafe": {
                            "type": "boolean"
                          },
                          "slots": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "weights": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          }
                        },
                        "required": [
                          "id",
                          "frame",
                          "flow",
                          "gap",
                          "scope",
                          "gutterSafe",
                          "slots",
                          "weights"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "regions"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "gutter": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "textSafety": {
                    "type": "number",
                    "minimum": 0
                  },
                  "imageSafety": {
                    "type": "number",
                    "minimum": 0
                  },
                  "allowImageCrossing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "width",
                  "textSafety",
                  "imageSafety",
                  "allowImageCrossing"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "label",
              "intent",
              "kind",
              "description",
              "slots",
              "variants",
              "gutter"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "manifest",
        "tokens",
        "layouts"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
